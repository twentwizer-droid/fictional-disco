# Copy this file to desk\.env on your PC and fill it in there. Never commit .env.
# Leave a line empty to "skip" it.

# Solana RPC. The public one is the default; a Helius/QuickNode URL with your key if layer 8 fails.
RPC_URL=https://api.mainnet-beta.solana.com

# Telegram bot token from @BotFather (send /start to your bot before running probe.py)
TG_TOKEN=

# Jev key from console.typesafe.ai (empty = Analyst runs in rules mode)
TYPESAFE_API_KEY=
