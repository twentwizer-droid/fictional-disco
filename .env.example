# Copy to .env and never commit it. ./install.sh does this for you.
# Comments go on their own lines (lines starting with #).

# Solana RPC with your API key (Helius, Triton, QuickNode...)
BH_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# BH_DB_PATH=data/bundlehunter.db
# Jito block engine closest to your server
# BH_JITO_URL=https://frankfurt.mainnet.block-engine.jito.wtf

# --- Telegram bot (bh serve) ---
# token from @BotFather
BH_TELEGRAM_TOKEN=
# your chat id: send /start to your bot and it tells you; several ids separated by commas
BH_TELEGRAM_ALLOWED_IDS=

# --- web panel (bh serve) ---
# required when the panel listens beyond localhost (Docker); ./install.sh fills it in
BH_WEB_PASSWORD=

# --- optional, for `bh check` ---
# AI verdict (bh check --ai, the ШІ-вердикт checkbox)
# ANTHROPIC_API_KEY=sk-ant-...
# X API: did the linked account post the contract address?
# BH_X_BEARER_TOKEN=...

# --- live trading only: a fresh hot wallet holding only what you can afford to lose ---
# BH_PRIVATE_KEY=base58_secret_key
# BH_KEYPAIR_PATH=/secrets/keypair.json
# BH_LIVE_TRADING=1
